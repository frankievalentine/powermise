{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "powermise",
  "version": "0.1.1",
  "identifier": "dev.powermise.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "powermise",
        "width": 1200,
        "height": 800,
        "minWidth": 880,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "An unofficial desktop companion for mise",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "longDescription": "powermise is an unofficial desktop companion for mise-en-place: browse and install tools, keep them up to date, manage projects, and check your setup's health — every action shows the mise command it runs.",
    "publisher": "powermise",
    "homepage": "https://powermise.pages.dev",
    "copyright": "Not affiliated with mise or jdx.",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0RDU2QzdGRDM2MEUyNjMKUldSajRtRFRmMnpWSkw4R2Zqb0UrekxITDZtNDdMdEM1UjEzbThLU0xueDAyaU1zaHZ4S2JuRWgK",
      "endpoints": [
        "https://github.com/frankievalentine/powermise/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
