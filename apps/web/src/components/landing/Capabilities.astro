---
const capabilities = [
  { name: 'Home', body: 'A getting-started checklist and how everything stands, at a glance.', status: 'ready' },
  { name: 'My Tools', body: 'Every tool and version, where it’s configured, and which ones nothing uses anymore.', status: 'ready' },
  { name: 'Discover', body: 'The full mise registry, most popular first and by category, with any version a click away.', status: 'ready' },
  { name: 'Updates', body: 'Everything outdated in one list, including versions past your pins. Upgrade one or all.', status: 'ready' },
  { name: 'Health', body: 'mise doctor, explained. Version checks, shell activation, and self-update.', status: 'ready' },
  { name: 'History', body: 'Every command powermise ran and how it went, kept between launches.', status: 'ready' },
  { name: 'Import', body: 'Bring over versions, Homebrew and Brewfiles, winget and Scoop, and global packages — with a dry run first.', status: 'ready' },
  { name: 'AI Setups', body: 'Install a curated AI coding environment — Claude, Codex, Antigravity, and more — in one step. Export it to your other computers.', status: 'ready' },
  { name: 'Projects', body: 'Per-project tools, env vars, and tasks with a form for their arguments — and a trust review first.', status: 'ready' },
  { name: 'This Computer', body: 'mise bootstrap: system packages, dotfiles, and macOS settings, with a preview.', status: 'ready' },
  { name: 'Settings', body: 'The settings people need, in plain words, with every other mise setting folded away below.', status: 'ready' },
  { name: 'MCP, Plugins & Skills', body: 'MCP servers for every agent through mise, each agent’s plugins, and skills from skills.sh.', status: 'ready' },
];
---

<section class="section capabilities" aria-labelledby="capabilities-heading">
  <div class="capabilities__heading" data-reveal>
    <p class="section-label">What’s inside</p>
    <h2 class="section-heading" id="capabilities-heading">A calm place for everything mise does.</h2>
  </div>
  <ul class="capabilities__grid">
    {capabilities.map((capability) => (
      <li class:list={['capability', `capability--${capability.status}`]} data-reveal>
        <div class="capability__top">
          <h3>{capability.name}</h3>
          {capability.status !== 'ready' && (
            <span class="capability__badge">{capability.status === 'next' ? 'Next' : 'Planned'}</span>
          )}
        </div>
        <p>{capability.body}</p>
      </li>
    ))}
  </ul>
  <a class="text-link" href="https://github.com/frankievalentine/powermise/blob/main/docs/ROADMAP.md" target="_blank" rel="noopener noreferrer">See the roadmap <span aria-hidden="true">↗</span></a>
</section>
