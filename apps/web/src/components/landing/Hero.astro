---
// The hero introduces the app; the live demo directly below is the proof.
// The download button and install command follow the visitor's OS (see the
// script below); without JavaScript they point at the install guide.
const releases = 'https://github.com/frankievalentine/powermise/releases';
---

<section class="home-hero" aria-labelledby="hero-heading">
  <canvas class="home-hero__field" data-hero-field aria-hidden="true"></canvas>
  <div class="home-hero__copy">
    <p class="eyebrow"><span class="eyebrow-dot" aria-hidden="true"></span>An unofficial desktop companion for mise</p>
    <h1 id="hero-heading">Every tool mise manages, <span class="gradient-text">laid out in one window.</span></h1>
    <p class="hero-description">
      powermise is a companion app for <a href="https://mise.jdx.dev" target="_blank" rel="noopener noreferrer">mise-en-place</a>. Browse 1,000+ tools,
      install the version you want, keep everything up to date, and check your setup’s health — and every
      click shows the exact mise command it runs.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="/getting-started/" data-download>
        <span data-download-label>Download powermise</span>
      </a>
      <a class="button button-secondary" href="#demo">Try the live demo <span aria-hidden="true">↓</span></a>
    </div>
    <div class="hero-install">
      <code data-install-command>curl -fsSL https://powermise.pages.dev/install.sh | sh</code>
      <button type="button" class="hero-install__copy" data-install-copy aria-label="Copy the install command">Copy</button>
    </div>
    <p class="hero-note">
      <span data-download-note>powermise isn’t code-signed yet, so the first launch of a downloaded installer takes one extra step.</span>
      <a href="/getting-started/#opening-it-the-first-time">How to open it</a>
    </p>
    <p class="hero-proof">
      <span aria-hidden="true">↳</span> Free and open source. Not affiliated with mise.
      <a href={`${releases}/latest`}>Other platforms</a>
    </p>
  </div>
</section>

<script>
  import { initializeHeroField } from './heroField.ts';

  // The right installer and install command for this visitor's OS.
  const latest = 'https://github.com/frankievalentine/powermise/releases/latest/download';
  const agent = navigator.userAgent;
  const os = /Windows/i.test(agent) ? 'windows' : /Mac OS X|Macintosh/i.test(agent) ? 'macos' : /Linux|X11/i.test(agent) && !/Android/i.test(agent) ? 'linux' : null;
  const downloads = {
    macos: { label: 'Download for macOS', file: 'powermise-macos-universal.dmg' },
    windows: { label: 'Download for Windows', file: 'powermise-windows-x64-setup.exe' },
    linux: { label: 'Download for Linux', file: 'powermise-linux-x86_64.AppImage' },
  } as const;
  const link = document.querySelector<HTMLAnchorElement>('[data-download]');
  const label = document.querySelector('[data-download-label]');
  if (os && link && label) {
    link.href = `${latest}/${downloads[os].file}`;
    label.textContent = downloads[os].label;
  }
  // What the first launch of an unsigned download looks like on this OS.
  // (Fixed strings, so innerHTML is safe here.)
  const notes = {
    macos:
      'Not signed by Apple yet. If macOS won’t open it, choose <strong>Open Anyway</strong> in System Settings › Privacy &amp; Security, or run <code>xattr -dr com.apple.quarantine /Applications/powermise.app</code>. The install command skips this step.',
    windows: 'Not code-signed yet. If Windows SmartScreen appears, click <strong>More info</strong>, then <strong>Run anyway</strong>.',
    linux:
      'Not code-signed yet. The install command sets up a .deb or .rpm; an AppImage needs <code>chmod +x</code> and FUSE 2 first.',
  } as const;
  const note = document.querySelector('[data-download-note]');
  if (os && note) note.innerHTML = `${notes[os]} `;
  const command = document.querySelector('[data-install-command]');
  if (os === 'windows' && command) command.textContent = 'irm https://powermise.pages.dev/install.ps1 | iex';
  const copy = document.querySelector<HTMLButtonElement>('[data-install-copy]');
  copy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(command?.textContent ?? '');
      copy.textContent = 'Copied';
      setTimeout(() => (copy.textContent = 'Copy'), 1600);
    } catch {
      copy.textContent = 'Select and copy';
    }
  });

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-field]');
  if (canvas && 'IntersectionObserver' in window && 'ResizeObserver' in window) {
    initializeHeroField(canvas).catch(() => canvas.remove());
  }
</script>
