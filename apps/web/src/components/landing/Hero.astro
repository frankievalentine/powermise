---
import DitheredChefHat from './DitheredChefHat.astro';

const installCommand = 'cargo install --path crates/powermise-cli';
---

<section class="hero hero--benefit" aria-labelledby="hero-heading">
  <div class="hero-copy">
    <h1 id="hero-heading">Your <span class="gradient-text">mise-en-place</span> for curated AI harnesses, tools, and integrations.</h1>
    <p class="hero-description">Choose from a catalog with a point of view. Powermise brings the right tools, settings, and integrations together around the harnesses you actually want to use.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/catalog/">Explore the catalog <span aria-hidden="true">→</span></a>
      <a class="button button-secondary" href="/getting-started/">Build a selection</a>
    </div>
    <p class="hero-proof"><span aria-hidden="true">↳</span> 18 harnesses. One shared source of truth.</p>
  </div>

  <div class="hero-art" data-reveal data-reveal-delay="2">
    <div class="hero-art__halo" aria-hidden="true"></div>
    <div class="hero-hat" aria-hidden="true">
      <DitheredChefHat showCaption={false} />
    </div>
    <div class="install-command">
      <span class="install-command__label">install powermise</span>
      <code>{installCommand}</code>
      <button class="copy-command" type="button" data-copy-command data-command={installCommand} aria-label="Copy install command">
        <svg class="copy-icon" viewBox="0 0 24 24" aria-hidden="true">
          <rect x="8" y="8" width="11" height="11" rx="2" />
          <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
        </svg>
        <svg class="check-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m5 12 4 4L19 6" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('[data-copy-command]');

  copyButton?.addEventListener('click', async () => {
    const command = copyButton.dataset.command;
    if (!command) return;

    try {
      await navigator.clipboard.writeText(command);
    } catch {
      copyButton.setAttribute('aria-label', 'Unable to copy install command');
      return;
    }
    copyButton.dataset.copied = 'true';
    copyButton.setAttribute('aria-label', 'Install command copied');

    window.setTimeout(() => {
      delete copyButton.dataset.copied;
      copyButton.setAttribute('aria-label', 'Copy install command');
    }, 4000);
  });
</script>
