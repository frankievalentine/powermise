---
import { Image } from 'astro:assets';
// Shown when the animation can't run (reduced motion, no WebGL): the app's
// own icon, the same dithered hat.
import appIcon from '../../assets/app-icon.png';

interface Props {
  compact?: boolean;
  showCaption?: boolean;
}

const { compact = false, showCaption = true } = Astro.props;
---

<figure
  class:list={['dithered-chef-hat', { 'dithered-chef-hat--compact': compact }]}
  data-dithered-chef-hat
  aria-label={compact ? undefined : "Dithered chef's hat"}
  aria-hidden={compact ? 'true' : undefined}
>
  <canvas class="dithered-chef-hat__canvas" data-dithered-chef-hat-canvas aria-hidden="true" tabindex="-1"></canvas>
  <div class="dithered-chef-hat__fallback" data-dithered-chef-hat-fallback>
    <Image
      src={appIcon}
      widths={compact ? [64, 128] : [160, 320]}
      sizes={compact ? '32px' : '160px'}
      alt={compact ? '' : 'The powermise app icon'}
      loading={compact ? 'eager' : 'lazy'}
      decoding="async"
    />
    {showCaption && !compact && <figcaption>Chef's hat rendered with ordered Bayer dithering.</figcaption>}
  </div>
</figure>

<script>
  type HatBounds = { left: number; top: number; width: number; height: number };

  const containers = document.querySelectorAll<HTMLElement>('[data-dithered-chef-hat]');
  const pointerBounds = new WeakMap<HTMLElement, HatBounds>();

  const updatePointerBounds = (container: HTMLElement) => {
    const rect = container.getBoundingClientRect();
    pointerBounds.set(container, {
      left: rect.left,
      top: rect.top,
      width: rect.width,
      height: rect.height,
    });
  };

  const resetPointer = (container: HTMLElement) => {
    container.style.setProperty('--hat-rotate-x', '0deg');
    container.style.setProperty('--hat-rotate-y', '0deg');
  };

  const recordCssPointer = (container: HTMLElement, clientX: number, clientY: number) => {
    const bounds = pointerBounds.get(container);
    if (!bounds || bounds.width <= 0 || bounds.height <= 0) return;
    const normalizedX = Math.max(-1, Math.min(1, ((clientX - bounds.left) / bounds.width) * 2 - 1));
    const normalizedY = Math.max(-1, Math.min(1, ((clientY - bounds.top) / bounds.height) * 2 - 1));
    container.style.setProperty('--hat-rotate-x', `${normalizedY * -5}deg`);
    container.style.setProperty('--hat-rotate-y', `${normalizedX * 7}deg`);
  };

  const bindCssPointer = (container: HTMLElement) => {
    updatePointerBounds(container);
    container.addEventListener('pointerenter', () => updatePointerBounds(container));
    container.addEventListener('pointermove', (event) => {
      if (event.pointerType === 'touch') return;
      recordCssPointer(container, event.clientX, event.clientY);
    }, { passive: true });
    container.addEventListener('pointerleave', () => resetPointer(container));
    container.addEventListener('pointercancel', () => resetPointer(container));
  };

  if ('ResizeObserver' in window) {
    const boundsObserver = new ResizeObserver((entries) => {
      for (const entry of entries) {
        if (entry.target instanceof HTMLElement) updatePointerBounds(entry.target);
      }
    });
    containers.forEach((container) => boundsObserver.observe(container));
  }

  containers.forEach(bindCssPointer);

  const enhance = (container: HTMLElement) => {
    const canvas = container.querySelector<HTMLCanvasElement>('[data-dithered-chef-hat-canvas]');
    if (!canvas) {
      container.classList.add('is-fallback');
      return;
    }

    import('./ditheredChefHat')
      .then(({ initializeDitheredChefHat }) => initializeDitheredChefHat(container, canvas))
      .then((dispose) => {
        if (!dispose) {
          container.classList.add('is-fallback');
          return;
        }
        window.addEventListener('pagehide', dispose, { once: true });
      })
      .catch(() => container.classList.add('is-fallback'));
  };

  if (
    window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
    !('IntersectionObserver' in window)
  ) {
    containers.forEach((container) => container.classList.add('is-fallback'));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const container = entry.target as HTMLElement;
          observer.unobserve(container);
          enhance(container);
        }
      },
      { rootMargin: '200px' },
    );
    containers.forEach((container) => observer.observe(container));
  }
</script>

<style>
  .dithered-chef-hat {
    --hat-rotate-x: 0deg;
    --hat-rotate-y: 0deg;
    position: relative;
    display: grid;
    min-block-size: 16rem;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    margin: 0;
    pointer-events: auto;
    transform: perspective(60rem) rotateX(var(--hat-rotate-x)) rotateY(var(--hat-rotate-y));
    transition: transform 700ms var(--pm-ease-out);
    will-change: transform;
  }

  .dithered-chef-hat--compact {
    min-block-size: 0;
  }

  .dithered-chef-hat__canvas,
  .dithered-chef-hat__fallback {
    grid-area: 1 / 1;
    inline-size: 100%;
    block-size: 100%;
  }

  .dithered-chef-hat__canvas {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 180ms ease-out;
  }

  .dithered-chef-hat__fallback {
    display: grid;
    visibility: hidden;
    justify-items: center;
    align-content: center;
    gap: 0.75rem;
    margin: 0;
    color: currentColor;
    text-align: center;
    opacity: 0;
    transition: opacity 180ms ease-out, visibility 180ms ease-out;
  }

  .dithered-chef-hat__fallback img {
    display: block;
    inline-size: min(10rem, 80%);
    block-size: auto;
  }

  .dithered-chef-hat--compact .dithered-chef-hat__fallback img {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
  }

  .dithered-chef-hat__fallback figcaption {
    max-inline-size: 22rem;
    font: inherit;
    font-size: 0.8125rem;
    line-height: 1.4;
    opacity: 0.72;
  }

  .dithered-chef-hat.is-enhanced .dithered-chef-hat__canvas {
    opacity: 1;
  }

  .dithered-chef-hat.is-painted .dithered-chef-hat__fallback {
    opacity: 0;
  }

  .dithered-chef-hat.is-fallback .dithered-chef-hat__fallback {
    visibility: visible;
    opacity: 1;
  }

  :global([data-theme='light']) .dithered-chef-hat.is-enhanced .dithered-chef-hat__canvas {
    filter: invert(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .dithered-chef-hat {
      transform: none;
      transition: none;
      will-change: auto;
    }

    .dithered-chef-hat__canvas {
      display: none;
    }

    .dithered-chef-hat__fallback {
      visibility: visible;
      opacity: 1;
    }
  }
</style>
