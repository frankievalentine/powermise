---
import { safeguards } from '../../data/landing.ts';
---

<section class="safeguard-bar" aria-label="Powermise safeguards" data-reveal>
  {safeguards.map(([title, description], index) => (
    <div class="safeguard-item" data-reveal data-reveal-delay={String(index + 1)}>
      <span class="safeguard-index">0{index + 1}</span>
      <strong>{title}</strong>
      <span>{description}</span>
    </div>
  ))}
</section>
