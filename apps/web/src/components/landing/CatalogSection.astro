---
import { harnesses } from '../../data/landing.ts';
---

<section class="section catalog-section catalog-section--marquee" id="ai-setups" aria-labelledby="catalog-heading" data-reveal>
  <div class="catalog-heading">
    <div>
      <p class="section-label">Also inside: AI Setups</p>
      <h2 class="section-heading" id="catalog-heading">Set up AI coding agents in one step.</h2>
    </div>
    <div class="catalog-heading__aside">
      <p class="section-sub">
        Pick the agents you want and powermise installs everything they need through mise — the CLI, the right
        runtimes, and optional desktop apps — with a preview of every change first.
      </p>
      <div class="catalog-stats" aria-label="Catalog summary">
        <span><strong>{harnesses.length}</strong> harnesses</span>
        <span><strong>macOS · Linux · Windows</strong></span>
      </div>
    </div>
  </div>

  <div class="harness-marquee" aria-label="Supported harnesses">
    <div class="marquee-track">
      <div class="marquee-group">
        {harnesses.map((harness) => (
          <span class:list={['marquee-item', { 'marquee-item--gap': harness.status === 'provider-gap' }]}>
            <strong>{harness.title}</strong>
            <small>{harness.category}</small>
          </span>
        ))}
      </div>
      <div class="marquee-group" aria-hidden="true">
        {harnesses.map((harness) => (
          <span class:list={['marquee-item', { 'marquee-item--gap': harness.status === 'provider-gap' }]}>
            <strong>{harness.title}</strong>
            <small>{harness.category}</small>
          </span>
        ))}
      </div>
    </div>
  </div>

  <a class="text-link" href="/ai-setups/">About AI Setups <span aria-hidden="true">↗</span></a>
</section>
