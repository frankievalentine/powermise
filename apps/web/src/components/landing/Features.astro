---
import { features } from '../../data/landing.ts';
---

<section class="section workflow-section" id="workflow" aria-labelledby="workflow-heading" data-reveal>
  <div class="workflow-heading">
    <p class="section-label">A calmer workflow</p>
    <h2 class="section-heading" id="workflow-heading">See the whole setup before you change it.</h2>
    <p class="section-sub">Curated does not mean mysterious. Every choice has a clear next step.</p>
  </div>
  <div class="features-grid">
    {features.map((feature) => (
      <article class="feature" id={feature.id} data-reveal>
        <p class="feature-number">{feature.number}</p>
        <h3>{feature.title}</h3>
        <p>{feature.description}</p>
        {feature.command ? (
          <code class="feature-command"><span aria-hidden="true">$ </span>{feature.command}</code>
        ) : null}
      </article>
    ))}
  </div>
</section>
