---
import SidebarSublist from '../../components/SidebarSublist.astro';

const { sidebar } = Astro.locals.starlightRoute;
---

<div class="sidebar">
  <div class="container-sidebar">
    <SidebarSublist sublist={sidebar} />
  </div>
</div>

<style>
  .sidebar {
    height: 100%;
    padding-top: var(--pm-space-6);
    padding-right: var(--pm-space-4);
    padding-bottom: var(--pm-space-6);
    overflow: auto;
    scrollbar-width: none;
  }

  @media (min-width: 64rem) {
    .sidebar {
      padding-top: var(--pm-space-8);
      padding-bottom: var(--pm-space-8);
    }
  }

  .container-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--pm-space-4);
  }
</style>
