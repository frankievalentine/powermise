---
// The page for any address that doesn't exist (Cloudflare Pages serves
// /404.html with a 404 status). It uses the marketing site's shell.
import DitheredChefHat from '../components/landing/DitheredChefHat.astro';
import Landing from '../layouts/Landing.astro';
---

<Landing
  title="Page not found — powermise"
  description="That page doesn’t exist on the powermise site."
  noindex
>
  <section class="closing not-found" aria-labelledby="not-found-heading">
    <div class="closing__hat" aria-hidden="true">
      <DitheredChefHat showCaption={false} />
    </div>
    <p class="not-found__code">404</p>
    <h1 class="closing__title" id="not-found-heading">That page isn’t on the menu.</h1>
    <p class="closing__body">
      There’s nothing at this address. It may have moved, or the link has a typo. Try the docs’ search, or start
      from the homepage.
    </p>
    <div class="closing__actions">
      <a class="button button-primary" href="/">Go to the homepage</a>
      <a class="button button-secondary" href="/getting-started/">Read the docs</a>
    </div>
  </section>
</Landing>

<style>
  .not-found {
    min-height: 70vh;
    padding-top: 7rem;
  }

  .not-found__code {
    margin: 1rem 0 0;
    color: var(--pm-accent);
    font-family: var(--pm-font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
  }
</style>
