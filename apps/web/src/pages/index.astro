---
import '@fontsource-variable/plus-jakarta-sans';

import BuildSection from '../components/landing/BuildSection.astro';
import CatalogSection from '../components/landing/CatalogSection.astro';
import Cta from '../components/landing/Cta.astro';
import Features from '../components/landing/Features.astro';
import Footer from '../components/landing/Footer.astro';
import Hero from '../components/landing/Hero.astro';
import Nav from '../components/landing/Nav.astro';
import SafetySection from '../components/landing/SafetySection.astro';
import TransferNote from '../components/landing/TransferNote.astro';
import Why from '../components/landing/Why.astro';
import '../styles/landing.css';

const title = 'Powermise — your mise-en-place for AI work';
const description = 'Choose from a curated catalog of AI harnesses and let Powermise bring the right tools, settings, and integrations together.';
const canonical = 'https://powermise.dev/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="powermise" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('js');
      (() => {
        const stored = localStorage.getItem('starlight-theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Nav />
    <main id="main">
      <Hero />
      <SafetySection />
      <CatalogSection />
      <BuildSection />
      <Features />
      <Why />
      <TransferNote />
      <Cta />
    </main>
    <Footer />

    <script>
      const revealElements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const leafRevealElements = revealElements.filter((element) => !element.querySelector('[data-reveal]'));
      const parentRevealElements = revealElements.filter((element) => element.querySelector('[data-reveal]'));
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealElement = (element: HTMLElement) => element.classList.add('is-revealed');

      parentRevealElements.forEach((element) => element.removeAttribute('data-reveal'));

      if (reducedMotion || !('IntersectionObserver' in window)) {
        leafRevealElements.forEach(revealElement);
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              revealElement(entry.target as HTMLElement);
              revealObserver.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 },
        );
        leafRevealElements.forEach((element) => revealObserver.observe(element));
      }
    </script>
    <script>
      const html = document.documentElement;
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');

      const applyTheme = (theme: 'light' | 'dark') => {
        html.setAttribute('data-theme', theme);
        const nextTheme = theme === 'dark' ? 'light' : 'dark';
        themeButton?.setAttribute('aria-label', `Use ${nextTheme} theme`);
      };

      applyTheme((html.getAttribute('data-theme') as 'light' | 'dark') ?? 'dark');

      themeButton?.addEventListener('click', () => {
        const currentTheme = html.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
        const theme = currentTheme === 'dark' ? 'light' : 'dark';
        applyTheme(theme);
        localStorage.setItem('starlight-theme', theme);
      });
    </script>
  </body>
</html>
