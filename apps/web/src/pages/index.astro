---
import AppDemo from '../components/landing/AppDemo.astro';
import Capabilities from '../components/landing/Capabilities.astro';
import CatalogSection from '../components/landing/CatalogSection.astro';
import Commands from '../components/landing/Commands.astro';
import Cta from '../components/landing/Cta.astro';
import Hero from '../components/landing/Hero.astro';
import Principles from '../components/landing/Principles.astro';
import Landing from '../layouts/Landing.astro';

const title = 'powermise — an unofficial desktop companion for mise';
const description = 'An unofficial desktop companion for mise: browse, install, and update every tool mise manages from one window, and see the exact mise command behind every click.';
const canonical = 'https://powermise.pages.dev/';
---

<Landing title={title} description={description} canonical={canonical}>
  <Hero />
  <AppDemo />
  <Commands />
  <Capabilities />
  <Principles />
  <CatalogSection />
  <Cta />
</Landing>
