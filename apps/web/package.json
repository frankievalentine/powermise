{
  "name": "@powermise/web",
  "version": "0.1.0",
  "description": "The powermise website and docs (Astro and Starlight), deployed to Cloudflare Pages.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run demo && astro dev",
    "check": "astro check",
    "build": "bun run demo && astro check && astro build",
    "demo": "bun run --cwd ../desktop build:demo",
    "deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/starlight": "^0.41.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.1.0",
    "astro": "^7.0.0",
    "gsap": "^3.13.0",
    "rehype-external-links": "^3.0.0",
    "sharp": "^0.34.4",
    "starlight-theme-black": "^0.6.0",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/three": "^0.183.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.151.0"
  }
}
