# Cloudflare Pages headers.

# The install scripts open as readable text in a browser (curl and
# PowerShell don't mind), and are never cached for long, so a fix reaches
# everyone right away.
/install.sh
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=300

# Astro's hashed build files never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
